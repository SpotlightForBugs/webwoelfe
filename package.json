{
  "name": "webwoelfe-village3d",
  "version": "1.0.0",
  "description": "3D Village Renderer for Webwölfe",
  "scripts": {
    "build:village3d": "tsc --project static/js/village3d/tsconfig.json",
    "build:hints": "tsc --project static/js/tsconfig.json",
    "watch:village3d": "tsc --project static/js/village3d/tsconfig.json --watch",
    "watch:hints": "tsc --project static/js/tsconfig.json --watch",
    "clean:village3d": "rimraf static/js/village3d/dist",
    "clean:hints": "rimraf static/js/dist",
    "clean": "npm run clean:village3d && npm run clean:hints",
    "prebuild": "npm run clean",
    "build": "npm run build:village3d && npm run build:hints"
  },
  "dependencies": {
    "@playwright/test": "^1.57.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.5",
    "@types/playcanvas": "^0.221.7",
    "@types/socket.io-client": "^1.4.36",
    "playcanvas": "^2.14.4",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
